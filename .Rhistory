alpha_mc2 = pivot_longer(alpha_mc,names_to = "G", values_to = "alpha")
alpha_mc2 = pivot_longer(as.data_frame(alpha_mc),names_to = "G", values_to = "alpha")
alpha_mc2 = pivot_longer(as.data.frame(alpha_mc),names_to = "G", values_to = "alpha")
