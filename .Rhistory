if (!is.data.frame(obj)) obj <- tryCatch(as.data.frame(obj), error = function(err) NULL)
if (is.null(obj)) return(FALSE)
write.csv(obj, file.path(out_dir, paste0(name, ".csv")), row.names = FALSE)
TRUE
}
# Run export loop ---------------------------------
ok <- vapply(ds_names, function(nm) tryCatch(export_one(nm), error = function(e) FALSE), logical(1))
cat(sprintf("Wrote %d/%d datasets to %s/\n", sum(ok), length(ok), out_dir))
if (any(!ok)) cat("Skipped (not a plain data.frame, or failed to load):\n",
paste(" -", names(ok)[!ok], collapse = "\n"), "\n")
