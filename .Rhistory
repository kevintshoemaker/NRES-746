Ricker <- function(x,a,b){
a*x*exp(-b*x)
}
NLL_myxRicker <- function(params){
mn <- Ricker(myxdat$day,params["a"],params["b"])
sh <- mn * params["rate"]
-sum(dgamma(myxdat$titer,shape=sh,rate=params["rate"],log=TRUE))
}
