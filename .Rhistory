# Load required packages
library(popbio)
# Define life history parameters
# {
# Survival rates
s_fledgling <- 0.66        # Fledgling survival (first year)
s_juvenile <- 0.73         # Juvenile survival
s_2yo_nonbreed <- 0.89     # 2-year-old non-breeder survival
s_2yo_breed <- 0.97        # 2-year-old breeder survival
s_3yo_nonbreed <- 0.89     # 3-year-old non-breeder survival
s_3yo_breed <- 0.97        # 3-year-old breeder survival
s_3yo_postbreed <- 0.79    # 3-year-old post-breeder survival
s_adult_prebreed <- 0.83   # Adult pre-breeder survival
s_adult_breed <- 0.95      # Adult breeder survival
s_adult_postbreed <- 0.79  # Adult post-breeder survival
# Transition probabilities (for survivors)
p_recruit <- 0.21                      # Recruitment probability (becoming breeder)
p_young_breed_to_skip <- 0.16          # Young breeders skipping breeding
p_3yo_post_to_breed <- 0.43            # 3yo post-breeders returning to breeding
p_adult_pre_to_breed <- 0.16           # Adult pre-breeders becoming breeders
p_adult_breed_to_skip <- 0.13          # Adult breeders skipping (to post-breeding)
p_adult_post_to_breed <- 0.43          # Adult post-breeders returning to breeding
# Fecundity (female offspring per female breeder)
f_breed <- 1.22 * 0.52                 # Breeders: 1.22 fledglings * 0.52 female
A <- matrix(0, nrow = 5, ncol = 5)
# Fledgling production (row 1)
A[1, 4] <- f_breed * s_fledgling    # From 2yo breeders
# Define life history parameters
# {
# Survival rates
s_juvenile <- 0.73         # Juvenile survival
s_2yo_nonbreed <- 0.89     # 2-year-old non-breeder survival
s_2yo_breed <- 0.97        # 2-year-old breeder survival
s_3yo_nonbreed <- 0.89     # 3-year-old non-breeder survival
s_3yo_breed <- 0.97        # 3-year-old breeder survival
s_3yo_postbreed <- 0.79    # 3-year-old post-breeder survival
s_adult_prebreed <- 0.83   # Adult pre-breeder survival
s_adult_breed <- 0.95      # Adult breeder survival
s_adult_postbreed <- 0.79  # Adult post-breeder survival
# Transition probabilities (for survivors)
p_recruit <- 0.21                      # Recruitment probability (becoming breeder)
p_young_breed_to_skip <- 0.16          # Young breeders skipping breeding
p_3yo_post_to_breed <- 0.43            # 3yo post-breeders returning to breeding
p_adult_pre_to_breed <- 0.16           # Adult pre-breeders becoming breeders
p_adult_breed_to_skip <- 0.13          # Adult breeders skipping (to post-breeding)
p_adult_post_to_breed <- 0.43          # Adult post-breeders returning to breeding
# Fecundity (female yearlings next year per female breeder this year: pre-breeding census)
f_breed <- 1.22 * 0.52 * 0.66     # Yearling production: 1.22 fledglings * 0.52 female * 0.66 (fledgling survival)
A <- matrix(0, nrow = 5, ncol = 5)
A <- matrix(0, nrow = 6, ncol = 6)
# survival of yearlings to age 2
A[2, 1] = s_juvenile   # survival from age 1 to age 2
