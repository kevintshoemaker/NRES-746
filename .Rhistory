fit_augmented <- augment(model.l)
?augment
fit_augmented <- augment(model.l)
ggplot(fit_augmented, aes(x=Time, group=as.factor(Chick)))+
geom_line(aes(y=weight), colour="black")+
geom_line(aes(y=.fitted), colour="red", alpha=1)+
xlab("Time")+ylab("BW")+
ggtitle("Observed vs Predicted")+
