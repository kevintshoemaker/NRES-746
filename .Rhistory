CI_myxRicker1 <- function(mle, H){
stderr = sqrt(diag(solve(H)))
moe = stderr*qnorm(0.025,lower=F)
cbind(mle=mle,sd=stderr,lwr=mle-moe,upr=mle+moe)
}
