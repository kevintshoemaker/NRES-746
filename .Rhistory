df = emdbook::ReedfrogSizepred
df
ricker = function(x,a,b) a*x*exp(-b*x)
sse = function(o,e) sum((o-e)^2)
apars = seq(0.1,5,length=100)
bpars = seq(0.05,2,length=100)
gd = expand.grid(apars,bpars)
names(gd) = c("a","b")
gd$sse  =  numeric(nrow(gd))
i=100
for(i in 1:nrow(gd)){
gd$sse[i] = sse(df$Kill,ricker(df$TBL,gd$a[i],gd$b[i]))
}
i=100
for(i in 1:nrow(gd)){
gd$sse[i] = sse(df$Kill,ricker(df$TBL,gd$a[i],gd$b[i]))
}
ndx=which.min(ssrs)
plot(df$TBL,df$Kill,xlim=c(0,50))
plot(df$TBL,df$Kill,xlim=c(0,50))
curve(ricker(x,gd$a[ndx],gd$b[ndx]),add=T)
ggplot(gd, aes(x = a, y = b, z = sse)) +
# Create the heatmap background
geom_raster(aes(fill = sse), interpolate = TRUE) +
# Add the contour lines
geom_contour(color = "white", linewidth = 0.5) +
# Add text labels to contour lines
geom_texthit(stat = "contour", aes(label = after_stat(level)),
color = "white", size = 3, check_overlap = TRUE) +
# Apply a smooth, modern color palette
scale_fill_viridis_c(option = "magma") +
# Clean up the presentation
theme_minimal() +
labs(
title = "Heatmap with Contour Lines",
x = "X Coordinate",
y = "Y Coordinate",
fill = "Z Value"
)
