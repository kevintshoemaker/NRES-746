geom_hline(yintercept = mean(samples$alpha0),col="darkgreen",lwd=2) +
geom_text(data=sampsize,aes(x=G,y=y,label=N)) +
ylim(min(alpha_mc2$alpha)-0.1,max(alpha_mc2$alpha)+0.1) +
theme_classic()
