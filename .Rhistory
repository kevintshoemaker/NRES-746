conditional
conditional2 <- function(xval) rnorm(1, rho * xval, sqrt(1 - rho^2))
gibbs<-function (n, rho){    # a Gibbs sampler for bivariate normal
mat <- matrix(ncol = 2, nrow = n)   # matrix for storing the random samples
prev <- c(0,0); mat[1, ] <- prev     # initialize the markov chain
for (i in 2:n) {
prev[1] <- conditional2[prev[2]]   # sample from full conditional
prev[2] <- conditional2[prev[1]]
mat[i,] <- prev
}
mat
}
bvn_gbs <-gibbs(10000,0.98)
mat <- matrix(ncol = 2, nrow = n)   # matrix for storing the random samples
prev <- c(0,0); mat[1, ] <- prev     # initialize the markov chain
prev[2]
rho
conditional2(0)
mat <- matrix(ncol = 2, nrow = n)   # matrix for storing the random samples
prev <- c(0,0); mat[1, ] <- prev     # initialize the markov chain
prev[1] <- conditional2[prev[2]]   # sample from full conditional
conditional2[prev[2]]
prev[2]
conditional2
prev[1] <- conditional2(prev[2])   # sample from full conditional
prev[2] <- conditional2(prev[1])
gibbs<-function (n, rho){    # a Gibbs sampler for bivariate normal
mat <- matrix(ncol = 2, nrow = n)   # matrix for storing the random samples
prev <- c(0,0); mat[1, ] <- prev     # initialize the markov chain
for (i in 2:n) {
prev[1] <- conditional2(prev[2])   # sample from full conditional
prev[2] <- conditional2(prev[1])
mat[i,] <- prev
}
mat
}
bvn_gbs <-gibbs(10000,0.98)
vis_mcmc2(bvn_gbs)
bvn_gbs <-gibbs(10000,0.9)
# Test the Gibbs sampler ------------------
