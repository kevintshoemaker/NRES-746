metropolisHastings <- function (n, rho=0.9){    # an MCMC bivariate random number generator
mat <- matrix(NA,2,n)   # matrix for storing the random samples
prev = c(0,0); mat[1,] <- prev       # initial values for all parameters
for(i in 1:n){
for(j in 1:2){
prev[j] <- choose_mh(prev[j],proposal(prev[j]),prev[setdiff(1:2,j)] )
}
mat[i,] <- prev
}
mat
}
