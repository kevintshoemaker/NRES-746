# export_emdbook_datasets.R
# Writes every dataset in the emdbook package to its own CSV, named exactly
# after the dataset object (e.g. ReedfrogSizepred -> ReedfrogSizepred.csv),
# into a data/ folder for Claude Code / future labs to read directly.
# Setup ---------------------------------
if (!requireNamespace("emdbook", quietly = TRUE)) install.packages("emdbook")
library(emdbook)
out_dir <- "data"
if (!dir.exists(out_dir)) dir.create(out_dir)
# Discover dataset names ---------------------------------
# data(package=...) returns one row per dataset object; strip anything
# after a space (handles rare "Name (Alias)" entries in the Item column)
ds_index <- data(package = "emdbook")$results
ds_names <- sub(" .*$", "", ds_index[, "Item"])
ds_names <- unique(ds_names)
# Export one dataset to CSV; returns TRUE/FALSE (used, not printed, below)
export_one <- function(name) {
e <- new.env()
data(list = name, package = "emdbook", envir = e)
obj <- get(name, envir = e)
if (!is.data.frame(obj)) obj <- tryCatch(as.data.frame(obj), error = function(err) NULL)
if (is.null(obj)) return(FALSE)
write.csv(obj, file.path(out_dir, paste0(name, ".csv")), row.names = FALSE)
TRUE
}
# Run export loop ---------------------------------
ok <- vapply(ds_names, function(nm) tryCatch(export_one(nm), error = function(e) FALSE), logical(1))
cat(sprintf("Wrote %d/%d datasets to %s/\n", sum(ok), length(ok), out_dir))
if (any(!ok)) cat("Skipped (not a plain data.frame, or failed to load):\n",
paste(" -", names(ok)[!ok], collapse = "\n"), "\n")
# NOTE: GobySurvival's documentation states it should not be redistributed
# or used in publications without permission from Bolker -- it will be
# exported here like everything else, but check emdbook's licensing terms
# before including data/GobySurvival.csv in anything shared beyond this
# course project.
