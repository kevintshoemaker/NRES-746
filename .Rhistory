Suppose there are 25 people in this room. Do you think it's more likely
factorial(365)
birthday_prob <- function(n, D = 365) {
if (n > D) return(1) # Pigeonhole principle
# log(P(D, n)) = log(D!) - log((D-n)!)
log_numerator <- lfactorial(D) - lfactorial(D - n)
# log(D^n) = n * log(D)
log_denominator <- n * log(D)
# P(no match) = exp(log_numerator - log_denominator)
p_no_match <- exp(log_numerator - log_denominator)
# P(at least one match)
return(1 - p_no_match)
}
birthday_prob(25)
